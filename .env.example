APP_DATABASE_PATH=/data/app.db
APP_SCHEDULER_POLL_SECONDS=60
APP_LINE_CHANNEL_ACCESS_TOKEN=
APP_LINE_CHANNEL_SECRET=
# APP_LINE_USER_ID には送信先 LINE アカウントの userId を入れる。
# 取得手順:
# 1. APP_LINE_CHANNEL_SECRET を設定した状態で api を起動する。
# 2. 送信先にしたい LINE アカウントから Bot へ 1 通メッセージを送る。
# 3. api ログに出る source.userId の U から始まる値を控える。
# 4. その値を APP_LINE_USER_ID に設定する。
# LINE Developers の Webhook 検証は events が空なので、この値の取得には使えない。
APP_LINE_USER_ID=
APP_SLACK_WEBHOOK_URL=
CLOUDFLARE_TUNNEL_TOKEN=
